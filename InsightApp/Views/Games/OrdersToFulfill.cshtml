@model List<OrderTable>

<div class="breadcrumbsPortal">
    <!------Breadcrumb------>
    <nav style="--bs-breadcrumb-divider: '>'; margin-top:10px; font-size:18px; font-weight: bold;" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Admin Panel</a></li>
            <li class="breadcrumb-item active" aria-current="page">Orders</li>
        </ol>
    </nav>
</div>
<div class="cart-container">
    <h3>Orders to Fulfill</h3>

    @if (Model == null || !Model.Any())
    {
        <!-- Show message when orders is empty -->
        <div class="empty-cart row">
                <div>
                    <img src="~/Imgs/empty.jpg" alt="No orders">
                </div>
                <hr />
                <h5>No Orders to Fulfill</h5>
        </div>
    }
    else
    {

        <!----------------table------------->
        <div class="d-flex flex-row bd-highlight mb-3">
            <table class="table table-bordered table-striped itemsPage" style="vertical-align: middle;">
                <thead>
                    <tr>
                        <th class="tableHheader" style="background-color:rgb(80, 140, 155); width:50px">Order</th>
                        <th class="tableHheader" style="background-color:rgb(80, 140, 155); width:150px">Date</th>
                        <th class="tableHheader" style="background-color:rgb(80, 140, 155); width:150px">Time</th>
                        <th class="tableHheader" style="background-color:rgb(80, 140, 155); width:200px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr style="height:60px; align-content:center;">
                            <td class="itemsPage"> # @o.OrderId</td>
                            <td class="itemsPage"> @o.OrderDate</td>
                            <td class="itemsPage"> @o.OrderTime</td>
                            <td class="itemsPage">
                                <a asp-controller="Games" asp-action="OrderPhysicalItems" asp-route-id="@o.OrderId" style="margin-right:20px;" role="button" class="btnFulfill">View Order</a>
                                <a asp-controller="Games" asp-action="FulfillOrder" asp-route-id="@o.OrderId" role="button" class="btnFulfill">Fulfill the Order</a>
                            </td>
  
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
    }
</div>