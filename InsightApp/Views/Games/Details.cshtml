                    <img src="~/Imgs/Games/Monopoly.jpg" alt="Image 3">
                    <img src="~/Imgs/Games/Minecraft.jpg" alt="Image 4">
                    <!----==========  DELETE THIS PART AFTER RETRIVING THE RECOMENDED ITEMS .... its just demo============---->

                </div>
            </div>

        </div> *@
    </div>



