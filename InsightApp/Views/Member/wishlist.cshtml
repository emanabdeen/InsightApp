@using InsightApp.Services
@model List<WishlistViewModel>

<div class="breadcrumbsPortal">
    <!------Breadcrumb------>
    <nav style="--bs-breadcrumb-divider: '>'; margin-top:10px; font-size:18px; font-weight: bold;" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Member" asp-action="MemberPortal">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Wish List</li>
        </ol>
    </nav>
</div>
@* <h1 style="margin-bottom:25px;">My Wishlist</h1> *@
<div class="wishlist-container">
    
    @if (Model == null || !Model.Any())
    {
        <!-- Show message when cart is empty -->
        <div class="empty-cart row">

            <div>
                <img src="~/Imgs/empty.jpg" alt="No items">
            </div>
            <hr />
            <h5>Your wish list is empty</h5>
            <div style="align-self:center; margin-top:30px; margin-bottom:30px;">
                @* <a asp-controller="Product" asp-action="products" role="button" class="btnCont">Shop Now</a> *@
            </div>
        </div>
    }
    else
    {
        string currentUrl = "https://www.InsightCVGS.com"; //Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path;
        string encCurrentUrl = System.Net.WebUtility.UrlEncode(currentUrl);
        string encTweetText = TweetUtilities.ConstructWishlistTweetText(Model, currentUrl);
        string tweetUrl = $"https://twitter.com/intent/tweet?url={encCurrentUrl}&text={encTweetText}";
        <a class="btn btn-primary" role="button"
           href=@tweetUrl data-size="large">
            Share your wishlist on X
        </a>
        <hr />
        List<string> wishlistGameNames = new List<string>();
        @foreach (var item in Model)
        {
            wishlistGameNames.Add(item.GameName);
            <!-- Example of product item -->
            <div class="product-item">
                <a class="col-1" style="padding-left:30px;" role="button" asp-controller="Member" asp-action="DeleteWhislistItem" asp-route-id="@item.WishlistItemId"><i class="bi bi-trash3 trash-icon"></i></a>
                <div class="product-info col-4">
                    <img src="@Url.Content(item.GameImageLink)" alt="Game Cover Image">
                    <h2>@item.GameName</h2>
                </div>
                <h6 class="col-4">$ @item.Price</h6>
                <a id="addToCartLink" asp-controller="Product" asp-action="details" asp-route-id="@item.GameId" role="button" class="add-cart">
                    View <i class="bi bi-eye"></i>
                </a> 
            </div>
        }

        
        
    }
    <script>
        window.twttr = (function(d, s, id) {
          var js, fjs = d.getElementsByTagName(s)[0],
            t = window.twttr || {};
          if (d.getElementById(id)) return t;
          js = d.createElement(s);
          js.id = id;
          js.src = "https://platform.twitter.com/widgets.js";
          fjs.parentNode.insertBefore(js, fjs);

          t._e = [];
          t.ready = function(f) {
            t._e.push(f);
          };

          return t;
        }(document, "script", "twitter-wjs"));</script>
</div>
